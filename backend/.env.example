# MongoDB
MONGO_URL=mongodb://localhost:27017
DB_NAME=easemybill

# AI OCR — the only AI provider used anywhere in this app.
# OCR_MODEL_ID is a generic alias; the underlying model name must never
# appear literally anywhere else in the codebase.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx
OCR_MODEL_ID=claude-sonnet-5

# Auth (Emergent Google OAuth — session exchange only, not an AI provider)
EMERGENT_LLM_KEY=
EMERGENT_AUTH_BASE=https://demobackend.emergentagent.com/auth/v1
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
SESSION_TTL_DAYS=7

# Frontend
REACT_APP_BACKEND_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:3000

# Optional integrations (all user-provided, all optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
