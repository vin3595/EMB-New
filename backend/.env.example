# MongoDB
MONGO_URL=mongodb://localhost:27017
DB_NAME=easemybill

# AI OCR — the only AI provider used anywhere in this app.
# OCR_MODEL_ID is a generic alias; the underlying model name must never
# appear literally anywhere else in the codebase.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx
OCR_MODEL_ID=claude-sonnet-5

# Auth (direct Google OAuth — create credentials at console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on the Google OAuth client
GOOGLE_REDIRECT_URI=http://localhost:8001/api/auth/google/callback
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
SESSION_TTL_DAYS=7

# Frontend
REACT_APP_BACKEND_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:3000
# Where the backend redirects to after a successful Google sign-in
FRONTEND_URL=http://localhost:3000

# Optional integrations (all user-provided, all optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
